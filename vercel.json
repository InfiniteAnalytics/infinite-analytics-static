{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "infiniteanalytics.com.au" }],
      "destination": "https://www.infiniteanalytics.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/:slug([^/]+)\\.php",
      "destination": "https://www.infiniteanalytics.com.au/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}
